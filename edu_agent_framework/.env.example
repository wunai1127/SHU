# ================================================
# 教育智能体框架 - 环境变量配置
# ================================================
# 复制此文件为 .env 并填入你的实际配置
# cp .env.example .env

# === LLM API 配置 ===

# DeepSeek API (推荐)
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 注意：LLM_BASE_URL 只需要填基础地址，不要包含 /chat/completions
# 正确示例：
#   https://api.deepseek.com
#   https://api.openai.com/v1
#   https://your-proxy.com/v1
# 错误示例：
#   https://api.deepseek.com/v1/chat/completions  ← 不要这样

# 使用代理的配置示例：
# LLM_BASE_URL=https://your-proxy-url.com/v1
# LLM_MODEL=gpt-4o

# === Embedding 配置 ===
# 可选：用于RAG知识检索
# EMBEDDING_API_KEY=your_embedding_api_key_here
# EMBEDDING_BASE_URL=https://api.deepseek.com
# EMBEDDING_MODEL=text-embedding-3-small

# === 服务配置 ===
# Web前端端口
WEB_PORT=8001

# 日志级别
LOG_LEVEL=INFO

# === 可选配置 ===
# 温度参数（0-1，越低越确定性）
LLM_TEMPERATURE=0.7

# 最大token数
LLM_MAX_TOKENS=2000
